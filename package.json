{
  "name": "slifer-launcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "packaging:branding": "powershell -ExecutionPolicy Bypass -File scripts/generate-branding.ps1",
    "packaging:icons": "tauri icon src-tauri/icons/icon-source.png",
    "packaging:keys": "tauri signer generate -w src-tauri/keys/slifer.key --ci -p slifer -f",
    "build:installer": "node scripts/build-installer.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.542.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.2",
    "three": "^0.185.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.8.3",
    "vite": "^8.0.16"
  }
}
